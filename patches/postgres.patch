diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..417930865d5bdf374e9a682e52865624a68ac4fa 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -172,11 +172,20 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         : (query = q, query.active = true)
 
       build(q)
-      return write(toBuffer(q))
+      // DIM patch (postgres@3.4.9): run onexecute even when the pipeline
+      // condition fails. sql.begin() passes onexecute on its BEGIN query to
+      // reserve the connection for the transaction; upstream only called it when
+      // `sent.length < max_pipeline` held, so max_pipeline: 0 skipped it and BEGIN
+      // died with UNSAFE_TRANSACTION (or a TypeError at max: 1). The return value
+      // keeps its meaning (truthy = this connection can take another query now)
+      // and stays falsy whenever onexecute is present, exactly as before, because
+      // begin's onexecute returns undefined.
+      const ok = write(toBuffer(q))
         && !q.describeFirst
         && !q.cursorFn
         && sent.length < max_pipeline
-        && (!q.options.onexecute || q.options.onexecute(connection))
+      q.options.onexecute && q.options.onexecute(connection)
+      return ok && !q.options.onexecute
     } catch (error) {
       sent.length === 0 && write(Sync)
       errored(error)
