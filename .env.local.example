# DIM — environment variables template
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; this file is committed as documentation.

# Public Supabase URL — exposed to the browser. Safe to commit if pointing at local.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Public anon key — safe to expose to the browser. Comes from `supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key — NEVER expose to the browser. Comes from `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — used by Drizzle for migrations and server-side queries.
# Default local Supabase password is "postgres".
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
