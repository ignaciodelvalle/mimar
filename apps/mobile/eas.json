{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dim-staging.vercel.app",
        "EXPO_PUBLIC_SUPABASE_URL": "https://agnwyifsdxxoznodutgq.supabase.co"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dim-staging.vercel.app",
        "EXPO_PUBLIC_SUPABASE_URL": "https://agnwyifsdxxoznodutgq.supabase.co"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.mimar.com.ar",
        "EXPO_PUBLIC_SUPABASE_URL": "https://agnwyifsdxxoznodutgq.supabase.co"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
